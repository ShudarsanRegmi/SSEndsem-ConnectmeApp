# Environment Configuration Template for ConnectMe
APP_ENV=production
APP_DEBUG=False
PORT=8000

# 256-bit Cryptographic Secret for JWT Signatures (Generate via `openssl rand -hex 32`)
JWT_SECRET_KEY=9f8c6e3d2a1b5c4e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=sqlite:///./connectme.db

# Media Storage Configuration
UPLOAD_DIRECTORY=./secure_media
MAX_UPLOAD_SIZE_BYTES=5242880
